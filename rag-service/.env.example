# App
APP_NAME="DeepDoc RAG Service"
APP_VERSION="0.1.0"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# LLM (OpenAI-compatible)
LLM_API_KEY="your-llm-api-key"
LLM_BASE_URL="https://chat.ecnu.edu.cn/open/api/v1"
LLM_MODEL="ecnu-max"

# Qdrant
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="deepdoc_chunks"
QDRANT_API_KEY=""
QDRANT_DISTANCE="Cosine"
VECTOR_DIMENSION=1024

# Embedding (OpenAI-compatible endpoint under EMBEDDING_BASE_URL + /embeddings)
EMBEDDING_MODEL="ecnu-embedding-small"
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_BATCH_SIZE=32

# Retrieval
RERANK_ENABLED=false

# Model cache (set to non-C drive path on Windows)
MODEL_CACHE_DIR="F:/Program/DeepDoc/.cache"
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Logging
LOG_LEVEL="INFO"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=104857600
