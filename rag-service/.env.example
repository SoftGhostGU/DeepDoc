# DeepDoc RAG Service 配置

# 项目配置
APP_NAME="DeepDoc RAG Service"
APP_VERSION="0.1.0"
DEBUG=false

# 服务配置
HOST="0.0.0.0"
PORT=8000

# ==================== LLM 配置 ====================
# MiniMax 示例
LLM_API_KEY="LLM_API_KEY.J4x6MiYCOypiDuDi"
LLM_BASE_URL="https://api.minimax.chat/v1"
LLM_MODEL="MiniMax-Text-01"
# 如使用 Grok (xAI)
# LLM_MODEL="grok-2"

# ==================== 向量库配置 (Qdrant Docker) ====================
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# ==================== Embedding 配置 ====================
EMBEDDING_MODEL="embedding-3"
VECTOR_DIMENSION=1024

# ==================== 日志配置 ====================
LOG_LEVEL="INFO"

# ==================== 文件配置 ====================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=104857600